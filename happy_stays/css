/* General Styles */
body {
    font-family: 'Poppins', sans-serif;
    margin: 0;
    padding: 0;
    background-color: #f5f5f5;
    color: #333;
}

/* Header */
.header {
    background: url('hotel-hero.jpg') center/cover no-repeat;
    height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    text-align: center;
}

.header h1 {
    font-size: 3rem;
    text-shadow: 2px 2px 10px rgba(0, 0, 0, 0.3);
}

/* Navigation */
.navbar {
    background: rgba(0, 0, 0, 0.7);
    padding: 15px;
    position: fixed;
    width: 100%;
    top: 0;
    z-index: 1000;
}

.navbar a {
    color: white;
    text-decoration: none;
    padding: 10px 20px;
}

.navbar a:hover {
    background: rgba(255, 255, 255, 0.3);
    border-radius: 5px;
}

/* Rooms Section */
.rooms {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
    padding: 40px;
}

.room {
    background: white;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
}

.room img {
    width: 100%;
    height: 200px;
    object-fit: cover;
}

.room .info {
    padding: 20px;
    text-align: center;
}

.room .info h3 {
    margin-bottom: 10px;
}

.room .info .price {
    color: #27ae60;
    font-weight: bold;
}

/* Booking Form */
.booking-form {
    background: white;
    padding: 30px;
    max-width: 500px;
    margin: 40px auto;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    border-radius: 8px;
}

